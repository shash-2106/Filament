# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database Configuration (Supabase / PostgreSQL)
# Example format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/filament_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication & Security
AUTH_SECRET_KEY=replace_with_a_secure_random_key_for_local_dev
AUTH_TOKEN_EXPIRE_MINUTES=60

# Model Provider / AI Integrations (Planned)
OPENAI_API_KEY=placeholder_openai_api_key
ANTHROPIC_API_KEY=placeholder_anthropic_api_key

