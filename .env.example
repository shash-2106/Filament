# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database Configuration (Supabase / PostgreSQL)
# Example format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/filament_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication & Security
AUTH_SECRET_KEY=replace_with_a_secure_random_key_for_local_dev
AUTH_TOKEN_EXPIRE_MINUTES=60

# Model Provider / AI Integrations (Meta Model API Gateway)
# All Meta API requests are strictly budget-controlled and disabled by default.
MODEL_API_KEY=placeholder_meta_model_api_key
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
MODEL_API_ENABLED=false
MODEL_API_LIFETIME_BUDGET_USD=100
MODEL_API_DAILY_BUDGET_USD=5
MODEL_API_INITIAL_TEST_BUDGET_USD=5
MODEL_API_MAX_REQUEST_COST_USD=0.10
MODEL_API_MAX_INPUT_TOKENS=20000
MODEL_API_MAX_OUTPUT_TOKENS=3000
MODEL_API_MAX_CONCURRENT_REQUESTS=1

